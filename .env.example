# Copy this file to .env and fill in local values. Do not commit .env.

# OpenAI-compatible endpoint used by local runner/judge.
OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://tokenhub.sensetime.com/v1
OPENAI_API_BASE=https://tokenhub.sensetime.com/v1

# Optional Gemini judge/model keys.
GEMINI_API_KEY=replace-with-your-key
GOOGLE_API_KEY=replace-with-your-key

# Optional provider keys for model smoke tests.
ANTHROPIC_API_KEY=replace-with-your-key
DEEPSEEK_API_KEY=replace-with-your-key
KIMI_API_KEY=replace-with-your-key

# Local OSWorld clone path.
OSWORLD_PATH=D:\gitWorkSpace\OSWorld

# Local OSWorld VM image path. Use the server VM path when running remotely.
OSWORLD_VM_PATH=C:\path\to\Ubuntu.qcow2

# Optional Windows/local compatibility flags.
OSWORLD_USE_CURL_OPENAI=1
ODYSSEYS_USE_CURL_OPENAI=1
PYTHONIOENCODING=utf-8
